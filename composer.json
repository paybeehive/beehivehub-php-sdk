{
    "name": "paybeehive/beehivehub-php-sdk",
    "description": "PHP SDK for BeehiveHub API",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpunit/php-code-coverage": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "BeehiveHub\\SDK\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BeehiveHub\\SDK\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable"
}
